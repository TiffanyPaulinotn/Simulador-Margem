# Login corporativo do Simulador de Margens (Microsoft / Entra ID)
# 1) Copie este arquivo para ".streamlit/secrets.toml" (sem o .exemplo) no SERVIDOR onde o simulador vai rodar.
# 2) Preencha com os dados que a TI gerar ao registrar o aplicativo no Microsoft Entra ID (Azure AD).
# 3) NUNCA envie o secrets.toml para o GitHub nem por e-mail.

[auth]
# endereço do simulador + /oauth2callback (cadastrar igual no Entra ID como "Redirect URI")
redirect_uri = "https://simulador.intercement.com/oauth2callback"
# texto aleatório e longo (ex.: gere com: python -c "import secrets; print(secrets.token_hex(32))")
cookie_secret = "TROCAR-POR-UM-TEXTO-ALEATORIO-LONGO"

[auth.microsoft]
client_id = "ID-DO-APLICATIVO-NO-ENTRA-ID"
client_secret = "SEGREDO-DO-APLICATIVO"
# troque <TENANT_ID> pelo ID do diretório (tenant) da InterCement
server_metadata_url = "https://login.microsoftonline.com/<TENANT_ID>/v2.0/.well-known/openid-configuration"
client_kwargs = { "prompt" = "select_account" }

[acesso]
provedor = "microsoft"
# só entra quem tiver e-mail destes domínios
dominios = ["intercement.com"]
